{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/ichirei",
        "destination": "https://ichirei.beyondculture.ai/",
        "type": 302
      },
      {
        "source": "/ichirei/:path*",
        "destination": "https://ichirei.beyondculture.ai/:path*",
        "type": 302
      }
    ]
  }
}
